# ─────────────────────────────────────────────────────────────
# Plumberr environment. Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Cerebras / Kimi K3.1 Pro ──────────────────────────────────
CEREBRAS_API_KEY=
# Confirmed via GET /v1/models on the hackathon key (Startup org).
CEREBRAS_MODEL_ID=moonshotai-kimi-k3.1-pro-trial
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# low | medium | high | max (Kimi default is max; low/medium keeps latency down)
CEREBRAS_REASONING_EFFORT=low

# ── Shared infra ──────────────────────────────────────────────
DATABASE_URL=postgres://plumberr:plumberr@localhost:5432/plumberr
REDIS_URL=redis://localhost:6379

# ── apps/api (Hono control plane) ─────────────────────────────
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SHOP_URL=http://localhost:4100
# Shared secret between api, OpenClaw tools/hooks, cerebras-proxy and demo-shop internal routes (gateway never holds GitHub creds)
PLUMBERR_INTERNAL_TOKEN=dev-internal-token-change-me
# HMAC secret used to sign POST /webhooks/alert
ALERT_HMAC_SECRET=dev-alert-secret-change-me
# Kill switch for the public "Break it" button
BREAK_ENABLED=true
OWNER_ADMIN_TOKEN=dev-owner-token-change-me
SENTRY_DSN=

# ── in-process runner (apps/api) ─────────────────────────────
API_URL=http://localhost:4000
DETECTOR_INTERVAL_MS=5000
# OpenClaw Gateway (leave OPENCLAW_URL empty to run the api in agent dry-run mode)
# Local native gateway: OPENCLAW_URL=http://127.0.0.1:18789  (bash scripts/setup-gateway.sh && bash scripts/dev-gateway.sh)
OPENCLAW_URL=
OPENCLAW_HOOK_TOKEN=
OPENCLAW_AGENT_ID=oncall
# Cerebras queue_time can be minutes under load; each agent turn waits in that queue
OPENCLAW_TIMEOUT_SECONDS=1500
# Gateway → Cerebras goes through the metadata-only logging proxy (services/cerebras-proxy).
# Set to https://api.cerebras.ai/v1 to bypass it.
OPENCLAW_CEREBRAS_BASE_URL=http://127.0.0.1:4300/v1
CEREBRAS_PROXY_PORT=4300
# FORCE_EFFORT=low injects reasoning_effort only when a request omits it.
FORCE_EFFORT=low

# ── services/demo-shop (victim service) ───────────────────────
SHOP_PORT=4100
# Shop's own loadgen is off; the api drives traffic (LOADGEN_RPS) in-process.
LOADGEN_RPS=20
DETECTOR_INTERVAL_MS=3000
AUTO_RESET_MS=600000
EVIDENCE_MAX_BYTES=8192
BREAK_RATE_LIMIT=3
BREAK_RATE_WINDOW_SEC=3600
# F2 seeds shop_orders (500k rows) in this DB; defaults to DATABASE_URL.
SHOP_DATABASE_URL=
LOG_LEVEL=info

# ── apps/gateway (OpenClaw on Railway) ────────────────────────
# 18789 locally; 8080 on Railway
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=
# Railway: /data/.openclaw and /data/workspace (volume). Local default: ~/.plumberr-openclaw
OPENCLAW_STATE_DIR=
OPENCLAW_WORKSPACE_DIR=
PLUMBERR_API_URL=http://127.0.0.1:4000

# ── GitHub App "Plumberr Bot" (PR-only, installed on target repo) ──
GH_APP_ID=
GH_INSTALLATION_ID=
# PEM with literal \n newlines
GH_APP_PRIVATE_KEY=
GH_WEBHOOK_SECRET=
GH_TARGET_REPO=your-github-user/plumberr-shop

# ── Observability (optional; tools fall back to demo-shop /internal/*) ──
GRAFANA_PROM_URL=
GRAFANA_LOKI_URL=
GRAFANA_TEMPO_URL=
GRAFANA_READ_TOKEN=
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_AUTH=

# ── apps/web (Next.js on Vercel) ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional abuse protection on /api/break
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
